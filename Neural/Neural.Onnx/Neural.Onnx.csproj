<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.16.3" />
        <PackageReference Condition="'$(TargetFramework)' != 'net8.0-maccatalyst'" Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.16.3" />
        <PackageReference Include="SixLabors.Fonts" Version="2.0.2" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.2" />
        <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Neural.Core\Neural.Core.csproj" />
      <ProjectReference Include="..\Neural.Defaults\Neural.Defaults.csproj" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Assets\Roboto-Regular.ttf">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </AdditionalFiles>
    </ItemGroup>

</Project>
